<?xml version='1.0' encoding='utf-8'?>
<widget id="com.study.game" version="1.0.2" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>StudyGame</name>
    <description>
        在StudyGame中答题以生存!
    </description>
    <author email="dev@cordova.apache.org" href="https://cordova.apache.org">
        JuFireX-Studio
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="android-buildToolsVersion" value="36.1.0" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-compileSdkVersion" value="36" />
    <preference name="android-targetSdkVersion" value="36" />
    <preference name="Orientation" value="landscape" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="webviewbounce" value="false" />
    <preference name="UIWebViewBounce" value="false" />
</widget>
